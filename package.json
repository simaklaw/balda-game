{
  "name": "balda-game",
  "private": true,
  "version": "0.1.0",
  "description": "Мультиплатформенная HTML5-игра «Балда» (Яндекс Игры, VK, OK, Telegram)",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs && npm run dict:test && npm run dict:verify && npm run dict:kpi",
    "build": "npm run build --workspace client",
    "start:server": "npm run start --workspace server",
    "smoke": "node scripts/smoke.mjs",
    "dict:build": "python3 -I tools/dict/build.py",
    "dict:verify": "python3 -I tools/dict/verify.py",
    "dict:test": "python3 -I -m unittest discover -s tools/dict -p 'test_*.py'",
    "dict:kpi": "node scripts/dict-kpi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
